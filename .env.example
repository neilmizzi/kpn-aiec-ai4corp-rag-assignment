# Copy to .env and fill in what you need. Never commit .env.
# Every value is optional; the defaults below are used when a variable is unset.

# LLM provider: kpn_gateway (uses `az login`, no key) or openai
LLM_PROVIDER=kpn_gateway

# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=

# Models (gateway names; with openai use e.g. gpt-4o-mini / gpt-4o)
LLM_MODEL=gpt-54-mini-2026-03-17
JUDGE_MODEL=gpt-54-2026-03-05

# Local sentence-transformers embedding model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Retrieval and storage
TOP_K=8
DATA_DIR=data

# Optional: Hugging Face token for faster downloads (avoids rate-limit warnings)
HF_TOKEN=
